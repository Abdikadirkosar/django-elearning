# ==============================================================================
# AQOONPLUS E-Learning Platform - Production Environment Variables
# ==============================================================================
# Rename this file to .env on your production server (e.g. VPS, DigitalOcean, AWS, Render)
# Do NOT commit your production .env with real secrets to public repositories!

DJANGO_SECRET_KEY=django-insecure-change-this-to-a-strong-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,aqoonplus.so,www.aqoonplus.so

# Database Configuration (Optional: for PostgreSQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/aqoonplus_db

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=contact@aqoonplus.so
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Payment Contacts
TELESOM_ZAAD_NUMBER=+252634812030
